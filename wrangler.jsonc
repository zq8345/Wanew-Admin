{
  // #52 产品后台一期 —— 独立 worker（与 Pages 站点同仓：运行时 regen 要 import ../functions/_lib/render.js，
  // 同仓=单真源不漂[W1b 教训]；与 getke worker 隔离=爆炸半径小+独立发版）。
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wanew-admin",
  // 账号显式钉死（批4 复盘：账号级令牌无 memberships 读权时 wrangler 会静默退出——写死后不再查账号列表。
  //   值=wrangler whoami 实测。域已由 Joe 控制台挂好 zone，后续 deploy 账号级令牌即可，详见 README）。
  "account_id": "7421acfcf984fd557bca79796dbb2cdb",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],

  // 失败要**事后可查**：审计日志是从 git commits 派生的，而一次失败**不产生 commit**——
  // 于是 07-27/28 Joe 连着两天保存失败，审计日志里干干净净。今天能定因只因为他恰好截了图。
  // 开了它，写入失败会以结构化 JSON 落进 Workers Logs（`wrangler tail` / 控制台可查）。
  // ⭐ 选 console 而不是写 R2：**失败时配额可能已经耗尽**，再花一次子请求去记录会直接失败——
  //    "只在失败路径上跑的代码"必须零放大，否则它只在系统已经不健康时才加重病情。console 不花子请求，也不会失败。
  // ⚠️ 保留期有限（免费档约数天），**不是长期归档**；要长期留痕得另想办法。
  "observability": { "enabled": true },

  // UI 壳（批3 电商风列表+编辑页）。run_worker_first：auth 中间件先跑，静态页也在 Access+M4 门后。
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },

  // R2 图床直传（桶名 tejoy-images 不改名——总工拍板；对外 URL 用 img.wanew.com 前缀）
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "tejoy-images" }],

  "vars": {
    // 图床对外前缀（新内容新域）；GITHUB_REPO 改名后的新仓
    "IMG_BASE": "https://img.wanew.com/",
    "GITHUB_REPO": "zq8345/Wanew",
    "GITHUB_BRANCH": "main",
    // 🔴 允许进入本后台的 Access 邮箱（逗号分隔）。**空 = 拒绝全部**，不是"不限制"。
    //    值取自实测：官网仓近 400 条 commit 里，`admin: … (邮箱)` 只出现过 joe@wanew.com（38 次），
    //    而那个邮箱正是 Access 头透出来的身份 —— 所以这不是猜的名单。
    // ⚠️ 放在 vars 而不是 secret，是为了**和代码同一次部署**：
    //    否则会有一段"代码已 fail-closed、变量还没配"的窗口，那段时间没有人进得来。
    // ⚠️ 加人只改这里 + 重新部署；改它不需要动代码。
    // 2026-08-02 加 susie@wanew.com（Joe 报同事登不上）。她早就在 Cloudflare Access 的
    // wanew-admin 策略里、过得了边缘那道门，卡的是这一行 —— **两道门是有意的，不是重复**：
    // Access 管「谁能走到门口」，这里管「谁能进后台」。
    // ⇒ 症状「Access 明明放行了却仍被拒」不是 bug，是这份名单没跟着加。排查先看是哪一道拒的：
    //    Cloudflare 自己的拒绝页 ≠ 本 worker 的「此账号不在本后台的允许名单内。」(src/index.ts:114)
    // ⚠️ 上面那句原写着"另外三个故意没加进来" —— **Joe 2026-08-02 明确要求加，那句已作废，别照它读。**
    //    我当初不自动拉平的理由仍然成立（这个 worker 的 GITHUB_TOKEN 能写官网仓，拉平=一次多发三把钥匙），
    //    但**这是所有者的决定，不是我的**：他管着 Access 那张名单，那五个就是他认可的人。
    // 🔴 这张名单本身是**过渡态，即将整个删除**：正在做 Access JWT 验签（AUD
    //    9198c82b…d19759）。验签落地后「这个头是真的」由密码学证明，Access 策略成为唯一名单，
    //    Joe 加人删人不再需要任何人改代码——那正是他提这件事的原因（"万一你们公司把我封号了"）。
    //    ⇒ 谁看到这行：**别往里加人，先问验签那批到哪一步了。**
    "ALLOWED_EMAILS": "joe@wanew.com,susie@wanew.com,zq8345@gmail.com,joe@tejoy.com,susie@tejoy.com"
    // 机密（wrangler secret put，printf 管道防 CRLF——10003 教训）：
    //   GITHUB_TOKEN   fine-grained PAT，Repository access 仅 zq8345/Wanew，Contents Read+write（Joe 生成中）
  },

  // custom_domain：部署时自动建 DNS+证书；Access 应用 wanew-admin 已预挂 → 上线即有 edge 门。
  "routes": [{ "pattern": "admin.wanew.com", "custom_domain": true }],
  // workers.dev 关闭：本后台无公开端点需求（回调/退订都不在这），少一个裸口。
  "workers_dev": false
}
